table.insert(allConnections, ModeButton.MouseButton1Click:Connect(function()
	if not scriptRunning then return end
	safeCall(function()
		removeAllHitboxes()
		
		if targetMode == "Torso" then
			targetMode = "Head"
			ModeButton.Text = "Target: HEAD"
		else
			targetMode = "Torso"
			ModeButton.Text = "Target: TORSO"
		end
	end, "ModeButton")
end))

table.insert(allConnections, EspButton.MouseButton1Click:Connect(function()
	if not scriptRunning then return end
	safeCall(function()
		espEnabled = not espEnabled
		if espEnabled then
			EspButton.Text = "ESP Outline: ON"
			EspButton.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
			recreateAllESP()
			updateESPInfoDisplay()
		else
			EspButton.Text = "ESP Outline: OFF"
			EspButton.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
			removeAllESP()
			updateESPInfoDisplay()
		end
	end, "EspButton")
end))

table.insert(allConnections, EspInfoButton.MouseButton1Click:Connect(function()
	if not scriptRunning then return end
	safeCall(function()
		espInfoMode = espInfoMode + 1
		if espInfoMode > 3 then espInfoMode = 0 end
		
		if espInfoMode == 0 then
			EspInfoButton.Text = "ESP Info: OFF"
			EspInfoButton.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
		elseif espInfoMode == 1 then
			EspInfoButton.Text = "ESP Info: NAME"
			EspInfoButton.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
		elseif espInfoMode == 2 then
			EspInfoButton.Text = "ESP Info: HEALTH"
			EspInfoButton.BackgroundColor3 = Color3.fromRGB(40, 100, 120)
		elseif espInfoMode == 3 then
			EspInfoButton.Text = "ESP Info: BOTH"
			EspInfoButton.BackgroundColor3 = Color3.fromRGB(120, 100, 40)
		end
		
		updateESPInfoDisplay()
	end, "EspInfoButton")
end))

table.insert(allConnections, ToggleButton.MouseButton1Click:Connect(function()
	if not scriptRunning then return end
	safeCall(function()
		extenderEnabled = not extenderEnabled
		if extenderEnabled then
			ToggleButton.Text = "Hitbox Extender: ON"
			ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
		else
			ToggleButton.Text = "Hitbox Extender: OFF"
			ToggleButton.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
			removeAllHitboxes()
		end
	end, "ToggleButton")
end))

table.insert(allConnections, PromptButton.MouseButton1Click:Connect(function()
	if not scriptRunning then return end
	safeCall(function()
		instantPromptsEnabled = not instantPromptsEnabled
		if instantPromptsEnabled then
			PromptButton.Text = "Instant Prompts: ON"
			PromptButton.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
		else
			PromptButton.Text = "Instant Prompts: OFF"
			PromptButton.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
			restorePromptDurations()
		end
	end, "PromptButton")
end))

table.insert(allConnections, ToggleUIButton.MouseButton1Click:Connect(function()
	if not scriptRunning then return end
	if not waitingForKeybind then
		waitingForKeybind = true
		ToggleUIButton.Text = "Press Key..."
		ToggleUIButton.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
	end
end))

table.insert(allConnections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not scriptRunning then return end
	if waitingForKeybind and input.UserInputType == Enum.UserInputType.Keyboard then
		toggleUIKeybind = input.KeyCode
		ToggleUIButton.Text = "Toggle UI: " .. tostring(toggleUIKeybind):gsub("Enum.KeyCode.", "")
		ToggleUIButton.BackgroundColor3 = Color3.fromRGB(80, 80, 120)
		waitingForKeybind = false
		print("DEBUG: Keybind set to:", toggleUIKeybind)
	elseif input.KeyCode == toggleUIKeybind and not gameProcessed and not waitingForKeybind then
		if uiMinimized then
			maximizeUI()
		else
			task.spawn(function() minimizeUI() end)
		end
	end
end))

table.insert(allConnections, KillButton.MouseButton1Click:Connect(function()
	killScript()
end))

