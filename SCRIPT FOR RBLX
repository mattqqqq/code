table.insert(allConnections, game:GetService("ProximityPromptService").PromptShown:Connect(function(prompt)
	if not scriptRunning or not instantPromptsEnabled then return end
	safeCall(function()
		if prompt and not originalPromptDurations[prompt] then
			originalPromptDurations[prompt] = prompt.HoldDuration
		end
		if prompt then
			prompt.HoldDuration = 0
		end
	end, "PromptShown")
end))

local lastESPRecreate = 0
local lastHitboxUpdate = 0
table.insert(allConnections, RunService.Heartbeat:Connect(function()
	if not scriptRunning then return end
	
	safeCall(function()
		local currentTime = tick()
		
		-- Recreate ESP every 1 second
		if currentTime - lastESPRecreate > 1 and espEnabled then
			lastESPRecreate = currentTime
			recreateAllESP()
		end
		
		-- Update ESP info display
		if espInfoMode > 0 and espEnabled then
			for _, p in ipairs(Players:GetPlayers()) do
				if p and p ~= LocalPlayer and p.Character then
					local label = ESPInfoDisplay:FindFirstChild("ESPInfo_" .. p.Name)
					local headPart = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("UpperTorso")
					local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
					
					if label and headPart and humanoid then
						local infoText = ""
						if espInfoMode == 1 then
							infoText = p.Name
						elseif espInfoMode == 2 then
							infoText = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
						elseif espInfoMode == 3 then
							infoText = p.Name .. "\n[" .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. "]"
						end
						label.Text = infoText
						
						local camera = workspace.CurrentCamera
						local headScreenPos, onScreen = camera:WorldToScreenPoint(headPart.Position + Vector3.new(0, 3, 0))
						
						if onScreen then
							label.Position = UDim2.new(0, headScreenPos.X - 50, 0, headScreenPos.Y - 50)
							label.Visible = true
						else
							label.Visible = false
						end
					end
				end
			end
		end
		
		-- Update hitboxes - optimized for performance
		if extenderEnabled and hitboxSize > 0 and currentTime - lastHitboxUpdate > 0.15 then
			lastHitboxUpdate = currentTime
			
			for _, p in ipairs(Players:GetPlayers()) do
				if p and p ~= LocalPlayer and p.Character then
					local char = p.Character
					local humanoid = char:FindFirstChildOfClass("Humanoid")
					
					if humanoid and humanoid.Health > 0 then
						local targetParts = {}
						
						-- Collect parts to create hitboxes for
						if targetMode == "Head" then
							local head = char:FindFirstChild("Head")
							if head then table.insert(targetParts, head) end
						else
							local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
							if torso then table.insert(targetParts, torso) end
						end
						
						-- Create or update hitbox for each target part
						for _, targetPart in ipairs(targetParts) do
							if targetPart then
								local hitboxName = "XenoExtendedHitbox_" .. targetPart.Name
								local hitbox = char:FindFirstChild(hitboxName)
								
								if not hitbox then
									hitbox = Instance.new("Part")
									hitbox.Name = hitboxName
									hitbox.Shape = Enum.PartType.Block
									hitbox.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
									hitbox.Color = Color3.fromRGB(255, 0, 0)
									hitbox.Transparency = 0.4
									hitbox.CanCollide = false
									hitbox.Massless = true
									hitbox.TopSurface = Enum.SurfaceType.Smooth
									hitbox.BottomSurface = Enum.SurfaceType.Smooth
									hitbox.CFrame = targetPart.CFrame
									hitbox.Parent = char
									
									-- Weld the hitbox to the target part
									local weld = Instance.new("WeldConstraint")
									weld.Part0 = targetPart
									weld.Part1 = hitbox
									weld.Parent = hitbox
								else
									-- Update hitbox size
									if hitbox.Size ~= Vector3.new(hitboxSize, hitboxSize, hitboxSize) then
										hitbox.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
									end
								end
							end
						end
					end
				end
			end
		end
	end, "Heartbeat")
end))

