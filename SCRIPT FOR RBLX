-- ===== ESP INFO DISPLAY ON SCREEN =====
local ESPInfoDisplay = Instance.new("ScreenGui")
ESPInfoDisplay.Name = "ESPInfoDisplay"
ESPInfoDisplay.ResetOnSpawn = false
ESPInfoDisplay.Parent = PlayerGui

-- 2. CONTROL STATE VARIABLES
local hitboxSize = 0
local extenderEnabled = false
local espEnabled = false
local espInfoMode = 0
local instantPromptsEnabled = false
local scriptRunning = true
local targetMode = "Torso"
local uiMinimized = false
local toggleUIKeybind = Enum.KeyCode.P
local waitingForKeybind = false

local originalPromptDurations = {}

local function safeCall(func, errorMsg)
	local success, error = pcall(func)
	if not success then
		print("DEBUG: ERROR -", errorMsg, "-", error)
	end
	return success
end

local function removeAllHitboxes()
	safeCall(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p and p.Character then
				for _, child in ipairs(p.Character:GetChildren()) do
					if child and child.Name:match("^XenoExtendedHitbox") then
						child:Destroy()
					end
				end
			end
		end
	end, "removeAllHitboxes")
end

local function removeAllESP()
	safeCall(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p and p.Character then
				for _, child in ipairs(p.Character:GetChildren()) do
					if child and child.Name == "XenoESP" then
						child:Destroy()
					end
				end
			end
		end
	end, "removeAllESP")
end

local function recreateAllESP()
	if not espEnabled then return end
	
	safeCall(function()
		removeAllESP()
		for _, p in ipairs(Players:GetPlayers()) do
			if p and p ~= LocalPlayer and p.Character then
				local char = p.Character
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				
				if humanoid and humanoid.Health > 0 then
					local highlight = Instance.new("Highlight")
					highlight.Name = "XenoESP"
					highlight.FillColor = Color3.fromRGB(255, 0, 0)
					highlight.FillTransparency = 0.8
					highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
					highlight.OutlineTransparency = 0
					highlight.Parent = char
				end
			end
		end
	end, "recreateAllESP")
end

local function updateESPInfoDisplay()
	safeCall(function()
		for _, child in ipairs(ESPInfoDisplay:GetChildren()) do
			if child then
				child:Destroy()
			end
		end
		
		if espInfoMode > 0 and espEnabled then
			for _, p in ipairs(Players:GetPlayers()) do
				if p and p ~= LocalPlayer and p.Character then
					local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
					if humanoid and humanoid.Health > 0 then
						local headPart = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("UpperTorso")
						if headPart then
							local textLabel = Instance.new("TextLabel")
							textLabel.Name = "ESPInfo_" .. p.Name
							textLabel.BackgroundTransparency = 1
							textLabel.TextScaled = true
							textLabel.Font = Enum.Font.GothamBold
							textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
							textLabel.TextStrokeTransparency = 0.5
							textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
							textLabel.Parent = ESPInfoDisplay
							
							local infoText = ""
							if espInfoMode == 1 then
								infoText = p.Name
							elseif espInfoMode == 2 then
								infoText = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
							elseif espInfoMode == 3 then
								infoText = p.Name .. "\n[" .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. "]"
							end
							
							textLabel.Text = infoText
							textLabel.Size = UDim2.new(0, 100, 0, 35)
						end
					end
				end
			end
		end
	end, "updateESPInfoDisplay")
end

local function restorePromptDurations()
	safeCall(function()
		for prompt, duration in pairs(originalPromptDurations) do
			if prompt and prompt.Parent then
				prompt.HoldDuration = duration
			end
		end
		table.clear(originalPromptDurations)
	end, "restorePromptDurations")
end

local function minimizeUI()
	uiMinimized = true
	ControlPanel.Size = UDim2.new(0, 220, 0, 25)
	ContentFrame.Visible = false
	MinimizeButton.Text = "+"
	NotificationLabel.Text = "UI is hidden, press '" .. tostring(toggleUIKeybind):gsub("Enum.KeyCode.", "") .. "' to show the UI"
	NotificationLabel.Visible = true
	task.wait(5)
	if NotificationLabel and NotificationLabel.Parent then
		NotificationLabel.Visible = false
	end
end

local function maximizeUI()
	uiMinimized = false
	ControlPanel.Size = UDim2.new(0, 220, 0, 340)
	ContentFrame.Visible = true
	MinimizeButton.Text = "-"
end

local function killScript()
	print("DEBUG: KILLING SCRIPT")
	scriptRunning = false
	
	for i, connection in ipairs(allConnections) do
		if connection then
			pcall(function()
				connection:Disconnect()
			end)
		end
		allConnections[i] = nil
	end
	
	removeAllHitboxes()
	removeAllESP()
	restorePromptDurations()
	
	if DrillzoneMasterGui and DrillzoneMasterGui.Parent then
		DrillzoneMasterGui:Destroy()
	end
	if ESPInfoDisplay and ESPInfoDisplay.Parent then
		ESPInfoDisplay:Destroy()
	end
	if NotificationLabel and NotificationLabel.Parent then
		NotificationLabel:Destroy()
	end
	
	print("DEBUG: SCRIPT KILLED")
end

